{
  "name": "dsh-free-web-search",
  "version": "0.1.0",
  "description": "DSH plugin: free DuckDuckGo search provider for ctx.web (no API key, no model round-trip); pins web.searchProvider to it",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-web": "^0.2.1-rc.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "web-search",
    "duckduckgo"
  ]
}
